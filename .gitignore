# ── 工具产物（M-08 收尾，P-07）───────────────────────────────
.zcodeignore
*.log.tmp
playwright-report/
test-results/

# ── 前端构建产物（如后续引入 npm 工具链时生效）─────────────────
node_modules
dist
/vendor

# ── 系统 / 编辑器 ──────────────────────────────────────────────
.DS_Store
*.swp

# ── Python ────────────────────────────────────────────────────
__pycache__/
*.pyc
*.egg-info/
.venv

# ── 原生编译产物 ──────────────────────────────────────────────
*.o
*.a

# ── 环境变量 ──────────────────────────────────────────────────
.env
/.env

# ── 大体积媒体（不入库）───────────────────────────────────────
*.mp4
*.avi
*.mov
*.wmv
*.flv
*.mkv
*.webm
*.m4v
*.mpeg
*.mpg
*.3gp
*.f4v
*.rmvb
*.vob

# ── 归档文件 ──────────────────────────────────────────────────
*.iso
*.dmg
*.rar
*.zip
*.gz

# ── Office / 文档产物（含用户财务数据，不入库）─────────────────
*.pdf
*.docx
*.doc
*.xls
*.xlsx
*.ppt
*.pptx
*.csv

# ── 测试 / 运行产物 ────────────────────────────────────────────
.pytest_cache/
.coverage
*.log
logs/
reports/
output/

# ── 含密钥 / 用户专属配置（同目录 *.example 模板例外，正常入库）──
config/agent_llm_config.json
config/storage.json

# ── 用户数据落盘物（含隐私，绝不入库）────────────────────────
# data/    = LocalFileStore 降级落盘（任务名 / 参数快照 / 完整对话历史）
# backups/ = pg_dump 备份（同上，且为全库快照）
# logs/ 已在上方「测试 / 运行产物」块忽略。
data/
backups/

# ── 本地工具元数据 ────────────────────────────────────────────
.workbuddy/
.hermes/
.codegraph/
.codegraph
.preview
.cozeproj/reduction

# ── 遗留备份文件 ──────────────────────────────────────────────
*.bak*

# ── 测试临时目录（沙箱环境指定 basetemp 时用）──────────────
.pytest_tmp

.pytest_tmp
.ptmp*
